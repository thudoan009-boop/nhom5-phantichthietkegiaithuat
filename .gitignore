# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging and build
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker and linter caches
.mypy_cache/
.pyright/
.ruff_cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editor and IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and log files
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo

# Generated benchmark outputs (if not intentionally tracked)
benchmark_results/
results/*.csv

# NOTE:
# Do not ignore README.md, source code, input.txt, or required report files.
# Keep docs/*.docx tracked because they are project deliverables.
